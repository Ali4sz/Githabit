        android:fillColor="#0d1117"
        android:strokeColor="#2ea344"
        android:strokeWidth="2.025"
        android:pathData="M21.9375,54 a5.0625,5.0625 0 1,0 10.125,0 a5.0625,5.0625 0 1,0 -10.125,0" />
    <!-- Trailing node -->
    <path
        android:fillColor="#0d1117"
        android:strokeColor="#2ea344"
        android:strokeWidth="2.025"
        android:pathData="M75.9375,54 a5.0625,5.0625 0 1,0 10.125,0 a5.0625,5.0625 0 1,0 -10.125,0" />
    <!-- Center done ring -->
    <path
        android:fillColor="#0d1117"
        android:strokeColor="#39d353"
        android:strokeWidth="2.025"
        android:pathData="M40.1625,54 a13.8375,13.8375 0 1,0 27.675,0 a13.8375,13.8375 0 1,0 -27.675,0" />
