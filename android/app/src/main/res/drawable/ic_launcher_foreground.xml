<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <!-- githabit-icon-dark.svg mapped into the adaptive icon's VISIBLE viewport.
         AdaptiveIconDrawable only reveals the central 72dp of the 108dp canvas
         (extraInsetFraction 0.25 => layers scaled 1.5x; visible = 108/1.5 = 72dp).
         So the 512 favicon badge is mapped to 72dp: everything here is the
         512->108 mapping scaled by 2/3. The mark then fills ~92% of the visible
         icon (the favicon's own proportion) with no cropping of the end nodes. -->
    <!-- Commit line -->
    <path
        android:strokeColor="#2ea344"
        android:strokeWidth="2.025"
        android:strokeLineCap="round"
        android:pathData="M27,54 L81,54" />
